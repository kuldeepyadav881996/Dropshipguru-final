<!-- Preloader -->
<div class="preloader" id="preloader">
  <img src="logo.png" alt="Dropship Guru" style="width:120px;height:120px;object-fit:contain;display:block;" onerror="this.outerHTML='<span style=&quot;width:120px;height:120px;border-radius:20px;background:linear-gradient(135deg,#f7b824,#14a8ff);display:flex;align-items:center;justify-content:center;font-weight:900;font-size:40px;color:#06110b;&quot;>DG</span>'">
  <div class="preloader-bar"><span></span></div>
  <p>Loading...</p>
</div>

<!-- Announcement Bar -->
<div class="announce-bar" role="banner" aria-label="Free business consultation">
  <span class="ab-gift" aria-hidden="true">🎁</span>
  <div class="ab-main">
    <span class="ab-eyebrow">🎓 Start Learning Today</span>
    <span class="ab-headline">Start Your Online Business Today</span>
    <span class="ab-badge"><span class="ab-star" aria-hidden="true">⭐</span> Free 1-on-1 Business Consultation</span>
  </div>
  <a href="consultation.html" class="ab-cta">Get Started <span class="ab-arrow" aria-hidden="true">→</span></a>
</div>

<!-- Header -->
<header class="site-header">
  <a href="index.html" class="brand">
    <img src="logo.png" alt="Dropship Guru" style="width:50px;height:50px;border-radius:8px;object-fit:cover;background:#05070c;display:block;" onerror="this.outerHTML='<span style=&quot;width:50px;height:50px;border-radius:8px;background:linear-gradient(135deg,#f7b824,#14a8ff);display:flex;align-items:center;justify-content:center;font-weight:900;font-size:18px;color:#06110b;&quot;>DG</span>'">
    <span>Dropship <b>Guru</b></span>
  </a>
  <button class="menu-btn" id="menuBtn" aria-label="Menu">☰</button>
  <nav id="navMenu">
    <a href="#products">Products</a>
    <a href="#why-us">Why Us</a>
    <a href="#categories">Categories</a>
    <a href="#roadmap">Roadmap</a>
