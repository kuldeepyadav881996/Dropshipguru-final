<section class="section reveal" id="problems">
  <div class="section-head">
    <span class="pill" style="color:#ff5b6c;background:rgba(255,91,108,0.1);border-color:rgba(255,91,108,0.4);">Kya Aap Bhi Ye Sochte Hain?</span>
    <h2>Ye Galtiyan Aapko <span class="accent-red">Rokti</span> Hain</h2>
