# Server
PORT=5000
NODE_ENV=development

# Comma-separated allowed frontend origins (no trailing slash)
CORS_ORIGINS=https://dropshipguru.in,https://www.dropshipguru.in,http://localhost:5500,http://127.0.0.1:5500

# ============================================================
# Razorpay
# ============================================================

# Razorpay Dashboard → API Keys
# KEY_ID is public (Checkout only).
# KEY_SECRET is server-only. NEVER put the secret in frontend.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Razorpay Dashboard → Webhooks
# Required when NODE_ENV=production
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx


# ============================================================
# PhonePe Payment Gateway
# ============================================================

# PhonePe Dashboard → API Keys / Credentials
# NEVER put PHONEPE_CLIENT_SECRET in frontend or GitHub.
PHONEPE_CLIENT_ID=your_phonepe_client_id
PHONEPE_CLIENT_SECRET=your_phonepe_client_secret

# PhonePe Client Version
PHONEPE_CLIENT_VERSION=1

# Use "sandbox" for local UAT testing with TEST credentials.
# On Render (live customer payments) this MUST be:
# PHONEPE_ENV=production
# together with PRODUCTION Client ID / Client Secret / Client Version
# from PhonePe Dashboard → Developer Settings (LIVE merchant).
# Never mix sandbox credentials with PHONEPE_ENV=production.
PHONEPE_ENV=sandbox

# PhonePe Merchant ID
PHONEPE_MERCHANT_ID=your_phonepe_merchant_id

# Page PhonePe returns the customer to after payment.
# Must be a page that exists — it verifies the payment server-side.
# The backend appends ?merchantOrderId=…&gateway=phonepe automatically.
PHONEPE_REDIRECT_URL=https://dropshipguru.in/payment-status.html

# PhonePe Dashboard → Webhooks → the Basic-auth pair you configure there.
# Required for /api/payment/phonepe/webhook to accept callbacks.
PHONEPE_WEBHOOK_USERNAME=your_phonepe_webhook_username
PHONEPE_WEBHOOK_PASSWORD=your_phonepe_webhook_password

# Optional: checkout session lifetime in seconds (PhonePe default applies if unset)
# PHONEPE_EXPIRE_AFTER_SECONDS=1200


# ============================================================
# Google Apps Script
# ============================================================

# Saves paid leads after payment verification
GOOGLE_SCRIPT_URL=your_google_apps_script_web_app_url


# ============================================================
# Optional
# ============================================================

# Maximum order amount in INR
MAX_ORDER_AMOUNT_INR=100000