# Server
PORT=5000
NODE_ENV=development

# Comma-separated allowed frontend origins (no trailing slash)
CORS_ORIGINS=https://dropshipguru.in,https://www.dropshipguru.in,http://localhost:5500,http://127.0.0.1:5500

# Razorpay — from Dashboard → API Keys
# KEY_ID is public (Checkout only). KEY_SECRET is server-only. NEVER put the secret in frontend.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Razorpay Dashboard → Webhooks (required when NODE_ENV=production)
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Optional: max order amount in INR
MAX_ORDER_AMOUNT_INR=100000
